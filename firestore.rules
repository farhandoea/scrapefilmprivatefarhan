rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Auth helper
    function isSignedIn() {
      return request.auth != null;
    }

    match /movie_lists/{listId} {
      // Allow public read access so anyone can view movie references
      allow read: if true;
      // Scraper uses Admin SDK which bypasses these rules
      allow write: if false; 
    }

    match /movie_history/{docId} {
      // Allow public read access to history data
      allow read: if true;
      allow write: if false;
    }
  }
}
